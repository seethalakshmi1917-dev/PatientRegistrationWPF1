<Window x:Class="PatientRegistrationWPF1.OpenFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open FILE"
        Height="700"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="12">

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="8"/>
          
            <RowDefinition Height="Auto"/>
          
            <RowDefinition Height="8"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="8"/>
          
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="8"/>
         
            <RowDefinition Height="Auto"/>
          
            <RowDefinition Height="8"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="8"/>
     
            <RowDefinition Height="Auto"/>
       
            <RowDefinition Height="8"/>
        
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="8"/>
            
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="8"/>
           
            <RowDefinition Height="Auto"/>
          
            <RowDefinition Height="8"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="8"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="8"/>
          
            <RowDefinition Height="Auto"/>
        
            <RowDefinition Height="8"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
            
            <RowDefinition Height="Auto"/>
         
        </Grid.RowDefinitions>

        <!-- FIN No. -->
        <TextBlock Text="FIN No. :" Grid.Row="0" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="txtFINNo" Width="90" Height="24" Margin="0,0,8,0"/>
            <CheckBox x:Name="chkDuplicateFIN" Content="Enable Duplicate FIN" 
                      VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>
        <Button Grid.Row="0" Grid.Column="2" Width="24" Height="24" Background="#9B59B6" 
                Foreground="White" Content="" FontSize="10"/>

        <!-- Start Date / Time -->
        <TextBlock Text="Start Date :" Grid.Row="2" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <DatePicker x:Name="dpStartDate" Width="110" Height="24" Margin="0,0,15,0"/>
            <TextBlock Text="Time:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock x:Name="txtTime" Text="10:36" FontWeight="Bold" 
                       VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>

        <!-- File No. / Visit No. -->
        <TextBlock Text="File No. :" Grid.Row="4" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="txtFileNo" Width="100" Height="24" Margin="0,0,15,0"/>
            <TextBlock Text="Visit No.:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtVisitNo" Width="50" Height="24" Text="1"/>
        </StackPanel>

        <!-- Patient Name -->
        <TextBlock Text="Patient Name :" Grid.Row="6" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="txtPatientName" Grid.Row="6" Grid.Column="1" Height="24"/>

        <!-- Patient Type -->
        <TextBlock Text="Patient Type :" Grid.Row="8" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <ComboBox x:Name="cmbPatientType" Grid.Row="8" Grid.Column="1" Height="24" SelectedIndex="0">
            <ComboBoxItem Content="Out Patient"/>
            <ComboBoxItem Content="In Patient"/>
        </ComboBox>

        <!-- Ordering Physician -->
        <TextBlock Text="Ordering Physician :" Grid.Row="10" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="txtOrderingPhysician" Grid.Row="10" Grid.Column="1" Height="24"/>
        <Button Grid.Row="10" Grid.Column="2" Width="24" Height="24" Background="#9B59B6" 
                Foreground="White" Content="🔍" FontSize="10"/>

        <!-- Activity Physician -->
        <TextBlock Text="Activity Physician :" Grid.Row="12" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="txtActivityPhysician" Grid.Row="12" Grid.Column="1" Height="24"/>
        <Button Grid.Row="12" Grid.Column="2" Width="24" Height="24" Background="#9B59B6" 
                Foreground="White" Content="🔍" FontSize="10"/>

        <!-- Specialty -->
        <TextBlock Text="Specialty :" Grid.Row="14" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox x:Name="cmbSpecialty" Width="130" Height="24" Margin="0,0,10,0" SelectedIndex="0">
                <ComboBoxItem Content="Complete"/>
            </ComboBox>
            <CheckBox x:Name="chkShowBySpecialty" Content="Show By Specialty" 
                      VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <!-- Type of Visit -->
        <TextBlock Text="Type of Visit :" Grid.Row="16" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <ComboBox x:Name="cmbVisitType" Grid.Row="16" Grid.Column="1" Height="24" SelectedIndex="0">
            <ComboBoxItem Content="New Patient"/>
            <ComboBoxItem Content="Follow Up"/>
        </ComboBox>

        <!-- Comments -->
        <TextBlock Text="Comments :" Grid.Row="18" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="txtComments" Grid.Row="18" Grid.Column="1" Height="24"/>

        <!-- Mode of Payment -->
        <TextBlock Text="Mode of Payment :" Grid.Row="20" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <ComboBox x:Name="cmbPaymentMode" Grid.Row="20" Grid.Column="1" Height="24" SelectedIndex="0">
            <ComboBoxItem Content="Cash"/>
            <ComboBoxItem Content="Credit Card"/>
            <ComboBoxItem Content="Insurance"/>
        </ComboBox>

        <!-- Pharmacy Entry -->
        <TextBlock Text="Pharmacy Entry :" Grid.Row="22" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="txtPharmacyEntry" Grid.Row="22" Grid.Column="1" 
                 Height="24" Width="100" HorizontalAlignment="Left"/>

        <!-- End Time (two boxes) -->
        <TextBlock Text="End Time :" Grid.Row="24" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <StackPanel Grid.Row="24" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="txtEndTimeStart" Width="70" Height="24" Margin="0,0,5,0"/>
            <TextBox x:Name="txtEndTimeEnd" Width="70" Height="24"/>
        </StackPanel>

        <!-- Visit Entry By -->
        <TextBlock Text="Visit Entry By :" Grid.Row="26" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0"/>
        <TextBox x:Name="txtVisitEntryBy" Grid.Row="26" Grid.Column="1" 
                 Height="50" IsReadOnly="True" Background="#E0E0E0" 
                 TextWrapping="Wrap" AcceptsReturn="True"/>

        <!-- ✅ FIXED: Bottom Border with FULLY VISIBLE Open/Close Buttons -->
        <Border Grid.Row="28" Grid.ColumnSpan="3" 
                BorderBrush="#888888" BorderThickness="1" Padding="15,12,15,15" 
                Margin="0,10,0,10" Background="#F0F0F0">
            <StackPanel>
                <!-- Print Single Sticker Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <CheckBox x:Name="chkPrintSingleSticker" VerticalAlignment="Center" IsChecked="True">
                        <TextBlock Text="Print Single Sticker" TextDecorations="Underline"/>
                    </CheckBox>
                    <Border Width="40" Height="22" Margin="8,0,0,0" BorderBrush="#666666" BorderThickness="1" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtStickerCount" Text="1" BorderThickness="0" 
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     Padding="0" FontSize="11"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <RepeatButton Height="10" Content="▲" FontSize="6" Padding="0,-2,0,0"/>
                                <RepeatButton Height="10" Content="▼" FontSize="6" Padding="0,-2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Show Time Checkbox - Centered -->
                <CheckBox x:Name="chkShowTime" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Show Time" TextDecorations="Underline"/>
                </CheckBox>

                <!-- ✅ Open/Close Buttons - Fully Visible -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Button Content="_Open" Width="100" Height="28" Margin="5" 
                            Click="BtnOpen_Click" FontSize="11"/>
                    <Button Content="_Close" Width="100" Height="28" Margin="5" 
                            Click="BtnClose_Click" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>